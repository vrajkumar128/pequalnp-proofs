import Mathlib
import PEqualNP.Defs

/-! Generated by circuit_synth. graph edge function, edges [(0, 1), (1, 2), (2, 3), (3, 4), (4, 0)], basis mono, 5 inputs, 7 gates.
Every computation is checked by the kernel with `decide` (no native code). -/

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

namespace CircuitSynth.C5

def gates : List Gate := [⟨GateOp.and, [1, 2]⟩, ⟨GateOp.or, [1, 4]⟩, ⟨GateOp.or, [2, 4]⟩, ⟨GateOp.or, [0, 5]⟩, ⟨GateOp.and, [3, 7]⟩, ⟨GateOp.and, [6, 8]⟩, ⟨GateOp.or, [9, 10]⟩]

def C0 : Circuit := ⟨gates, 11⟩

theorem fan0 : FanInTwo C0 := by
  unfold FanInTwo
  simp [C0, gates]

theorem mono0 : Monotone2 C0 := by
  unfold Monotone2
  simp [C0, gates]

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem tab0 : ∀ b0 b1 b2 b3 b4 : Bool,
    C0.eval [b0, b1, b2, b3, b4] = ((b0 && b1) || (b1 && b2) || (b2 && b3) || (b3 && b4) || (b4 && b0)) := by
  decide

theorem eval0 (x : Fin 5 → Bool) : C0.eval (List.ofFn x) = (fun x : Fin 5 → Bool => (x 0 && x 1) || (x 1 && x 2) || (x 2 && x 3) || (x 3 && x 4) || (x 4 && x 0)) x := by
  have h : List.ofFn x = [x 0, x 1, x 2, x 3, x 4] := by simp [List.ofFn_succ]
  rw [h, tab0]

theorem main0 : HasCircuitSize 5 (fun x : Fin 5 → Bool => (x 0 && x 1) || (x 1 && x 2) || (x 2 && x 3) || (x 3 && x 4) || (x 4 && x 0)) 7 :=
  ⟨C0, fan0, by decide, eval0⟩

end CircuitSynth.C5
