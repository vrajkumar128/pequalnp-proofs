theorem tab0 : ∀ b0 b1 b2 b3 : Bool,
    C0.eval [b0, b1, b2, b3] = (b0 || b1 || b2) := by
  decide

theorem eval0 (x : Fin 4 → Bool) : C0.eval (List.ofFn x) = (fun x : Fin 4 → Bool => x 0 || x 1 || x 2) x := by
  have h : List.ofFn x = [x 0, x 1, x 2, x 3] := by simp [List.ofFn_succ]
  rw [h, tab0]

theorem main0 : HasCircuitSize 4 (fun x : Fin 4 → Bool => x 0 || x 1 || x 2) 4 :=
