/-- All outputs from one shared list of 4 gates. -/
theorem shared : gates.length ≤ 4 ∧ ∀ x : Fin 4 → Bool, C0.eval (List.ofFn x) = (fun x : Fin 4 → Bool => x 0 || x 1 || x 2) x ∧ C1.eval (List.ofFn x) = (fun x : Fin 4 → Bool => x 1 || x 2 || x 3) x ∧ C2.eval (List.ofFn x) = (fun x : Fin 4 → Bool => x 0 || x 3) x :=
  ⟨by decide, fun x => ⟨eval0 x, eval1 x, eval2 x⟩⟩

