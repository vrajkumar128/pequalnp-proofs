open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

namespace CircuitSynth.sums

def gates : List Gate := [⟨GateOp.or, [1, 2]⟩, ⟨GateOp.or, [0, 3]⟩, ⟨GateOp.or, [0, 4]⟩, ⟨GateOp.or, [3, 4]⟩]

